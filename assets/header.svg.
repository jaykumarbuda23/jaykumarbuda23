<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 260" width="1000" height="260">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#0B0F1E"/>
      <stop offset="1" stop-color="#1A1033"/>
    </linearGradient>
    <linearGradient id="txt" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#5EEAD4"/>
      <stop offset="0.5" stop-color="#C4B5FD"/>
      <stop offset="1" stop-color="#F9A8D4"/>
    </linearGradient>
    <linearGradient id="scan" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#5EEAD4" stop-opacity="0"/>
      <stop offset="1" stop-color="#5EEAD4" stop-opacity="0.22"/>
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M40 0H0V40" fill="none" stroke="#C4B5FD" stroke-opacity="0.09"/>
    </pattern>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3" result="b"/>
      <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>

  <rect width="1000" height="260" fill="url(#bg)"/>
  <rect width="1000" height="260" fill="url(#grid)"/>

  <!-- scanning line -->
  <rect width="1000" height="70" y="-70" fill="url(#scan)">
    <animateTransform attributeName="transform" type="translate" values="0,0; 0,340" dur="4s" repeatCount="indefinite"/>
  </rect>

  <!-- rotating rings -->
  <g transform="translate(850,130)" fill="none" filter="url(#glow)">
    <circle r="78" stroke="#5EEAD4" stroke-width="1.5" stroke-dasharray="6 14">
      <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="24s" repeatCount="indefinite"/>
    </circle>
    <circle r="56" stroke="#C4B5FD" stroke-width="1.5" stroke-dasharray="30 12">
      <animateTransform attributeName="transform" type="rotate" from="360" to="0" dur="16s" repeatCount="indefinite"/>
    </circle>
    <circle r="34" stroke="#F9A8D4" stroke-width="1.5" stroke-dasharray="4 8">
      <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="9s" repeatCount="indefinite"/>
    </circle>
    <circle r="6" fill="#5EEAD4" stroke="none">
      <animate attributeName="opacity" values="1;0.3;1" dur="2s" repeatCount="indefinite"/>
    </circle>
  </g>

  <!-- corner brackets -->
  <g stroke="#5EEAD4" stroke-width="2" fill="none" opacity="0.8">
    <path d="M20 50V20H50"/>
    <path d="M980 50V20H950"/>
    <path d="M20 210V240H50"/>
    <path d="M980 210V240H950"/>
  </g>

  <!-- text -->
  <text x="60" y="118" font-family="'Courier New', monospace" font-size="52" font-weight="700" letter-spacing="8" fill="url(#txt)" filter="url(#glow)">
    JAI KUMAR BUDA
    <animate attributeName="opacity" values="0;1" dur="1.4s" fill="freeze"/>
  </text>
  <text x="62" y="158" font-family="'Courier New', monospace" font-size="18" letter-spacing="4" fill="#E2E8F0" opacity="0.9">
    &gt; MERN STACK DEVELOPER // FULL-STACK WEB
  </text>

  <!-- status -->
  <circle cx="66" cy="204" r="5" fill="#5EEAD4">
    <animate attributeName="opacity" values="1;0.15;1" dur="1.6s" repeatCount="indefinite"/>
  </circle>
  <text x="82" y="209" font-family="'Courier New', monospace" font-size="14" letter-spacing="3" fill="#C4B5FD">
    SYSTEM ONLINE // LEARNING JAVA FULL-STACK
  </text>
</svg>
